# Для открытия файла по S3 presigned URL из браузера.
# При запуске на удалённом компьютере укажите доступный браузеру hostname.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9200

# Публичное зеркало зафиксированной старой версии MinIO CE (учебный стенд).
# При наличии собственной проверенной сборки смените образ.
MINIO_IMAGE=public.ecr.aws/y9w4h2u9/minio:RELEASE.2025-09-07T16-13-09Z
